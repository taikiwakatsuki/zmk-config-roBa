#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define JP_KANA LANGUAGE_1
#define JP_EISU LANGUAGE_2

#define MAC       0
#define MAC_FN    1
#define MAC_NUM   2
#define MAC_ARROW 3
#define WIN       4
#define WIN_FN    5
#define WIN_NUM   6
#define WIN_ARROW 7
#define MOUSE     8
#define BT        9

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <MOUSE>;
    scroll-layers = <BT>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
            layers = <MAC MAC_FN MAC_NUM MAC_ARROW>;
        };

        muhennkann_win {
            bindings = <&to_layer_win INT_MUHENKAN>;
            key-positions = <11 10>;
            layers = <WIN WIN_FN WIN_NUM WIN_ARROW>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to MAC &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        to_layer_win: to_layer_win {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to WIN &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_WIN";
        };

        to_mac: to_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &bt BT_SEL 0 &to MAC>;
            label = "TO_MAC";
        };

        to_win: to_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &bt BT_SEL 1 &to WIN>;
            label = "TO_WIN";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lt_to_layer_win: lt_to_layer_win {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_WIN";
            bindings = <&mo>, <&to_layer_win>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_default {
            bindings = <
&kp Q      &kp W         &kp E         &kp R                        &kp T                                                          &kp Y        &kp U  &lt 0 I    &kp O    &kp P
&kp A      &kp S         &kp D         &kp F                        &kp G        &kp LS(LG(S))                    &kp MINUS        &kp H        &kp J  &kp K      &kp L    &kp COLON
&kp Z      &kp X         &kp C         &kp V                        &kp B        &kp LEFT_SHIFT                   &kp RIGHT_SHIFT  &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp GLOBE  &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 MAC_FN LANGUAGE_2  &lt MAC_NUM SPACE  &lt_to_layer_0 MAC_ARROW LANGUAGE_1      &kp BACKSPACE    &lt BT ENTER                             &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        mac_function {
            bindings = <
&trans     &kp LG(W)  &kp TAB    &kp LG(R)  &kp LG(T)                           &kp F1         &kp LG(U)     &kp LS(LG(KP_NUMBER_3))  &kp LS(LG(KP_NUMBER_4))  &kp F5
&trans     &kp LG(S)  &kp LG(D)  &kp LG(F)  &kp LC(SPACE)  &trans      &kp F13  &kp F6         &msc SCRL_UP  &msc SCRL_DOWN           &kp F9                   &kp F10
&kp LG(Z)  &trans     &kp LG(C)  &kp LG(V)  &kp LG(B)      &trans      &trans   &trans         &trans        &trans                   &trans                   &kp F11
&trans     &trans     &trans     &trans     &trans         &trans      &trans   &kp RG(ENTER)                                                                  &kp F12
            >;
        };

        mac_num {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                                   &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL                    &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &kp KP_NUMBER_0  &trans           &trans        &trans                       &trans          &trans                                                                     &kp PIPE
            >;
        };

        mac_arrow {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &kp LC(T)                      &kp LC(F)        &kp TAB                    &trans                    &trans       &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END    &trans      &trans  &kp LS(LC(TAB))  &kp LS(LG(RIGHT_BRACKET))  &kp LG(LS(LEFT_BRACKET))  &kp LC(TAB)  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans     &trans      &trans  &trans           &trans                     &trans                    &trans       &trans
&trans          &trans                  &trans          &trans                   &trans     &trans      &trans  &trans                                                                             &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        win_default {
            bindings = <
&kp Q      &kp W      &kp E         &kp R                        &kp T                                                          &kp Y        &kp U  &lt 0 I    &kp O    &kp P
&kp A      &kp S      &kp D         &kp F                        &kp G        &kp LS(LG(S))                    &kp MINUS        &kp H        &kp J  &kp K      &kp L    &kp COLON
&kp Z      &kp X      &kp C         &kp V                        &kp B        &kp LEFT_SHIFT                   &kp RIGHT_SHIFT  &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp GLOBE  &kp RCTRL  &kp LEFT_ALT  &lt_to_layer_win WIN_FN LANGUAGE_2  &lt WIN_NUM SPACE  &lt_to_layer_win WIN_ARROW LANGUAGE_1      &kp BACKSPACE    &lt BT ENTER                             &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        win_function {
            bindings = <
&trans     &kp LC(W)  &kp TAB    &kp LC(R)  &kp LC(T)                           &kp F1         &kp LC(U)     &kp LS(LG(KP_NUMBER_3))  &kp LS(LG(KP_NUMBER_4))  &kp F5
&trans     &kp LC(S)  &kp LC(D)  &kp LC(F)  &kp LC(SPACE)  &trans      &kp F13  &kp F6         &msc SCRL_UP  &msc SCRL_DOWN           &kp F9                   &kp F10
&kp LC(Z)  &trans     &kp LC(C)  &kp LC(V)  &kp LC(B)      &trans      &trans   &trans         &trans        &trans                   &trans                   &kp F11
&trans     &trans     &trans     &trans     &trans         &trans      &trans   &kp RG(ENTER)                                                                  &kp F12
            >;
        };

        win_num {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                                   &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL                    &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &kp KP_NUMBER_0  &trans           &trans        &trans                       &trans          &trans                                                                     &kp PIPE
            >;
        };

        win_arrow {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &kp LC(T)                      &kp LC(F)        &kp TAB                    &trans                    &trans       &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END    &trans      &trans  &kp LS(LC(TAB))  &kp LS(LG(RIGHT_BRACKET))  &kp LG(LS(LEFT_BRACKET))  &kp LC(TAB)  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans     &trans      &trans  &trans           &trans                     &trans                    &trans       &trans
&trans          &trans                  &trans          &trans                   &trans     &trans      &trans  &trans                                                                             &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB4  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        set_bluetooth {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &to_mac  &to_win  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans   &trans   &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans   &trans   &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                        &bt BT_CLR_ALL
            >;
        };
    };
};
